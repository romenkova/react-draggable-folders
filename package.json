{
  "name": "react-draggable-folders",
  "version": "0.0.2",
  "private": false,
  "license": "MIT",
  "homepage": "https://romenkova.github.io/react-draggable-folders/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romenkova/react-draggable-folders.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config example/vite.config.ts",
    "build:example": "vite build --config example/vite.config.ts --base ./",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hello-pangea/dnd": "18.0.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "2.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "lucide-react": "1.48.0",
    "marked": "18.1.1",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sugar-high": "2.6.3",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4",
    "typescript": "~6",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
